{
  "name": "campus-bites",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "dev": "node scripts/dev.js",
    "dev:student": "vite student-app --config student-app/vite.config.js --port 5173 --host",
    "dev:admin": "vite admin-app --config admin-app/vite.config.js --port 5174 --host",
    "dev:lhk": "vite lhk-admin-app --config lhk-admin-app/vite.config.js --port 5175 --host",
    "dev:clg": "vite clg-admin-app --config clg-admin-app/vite.config.js --port 5176 --host",
    "dev:rider": "vite rider-app --config rider-app/vite.config.js --port 5177 --host",
    "build": "node scripts/build-unified.js",
    "vercel-build": "node scripts/build-unified.js",
    "build:all": "vite build student-app --config student-app/vite.config.js && vite build admin-app --config admin-app/vite.config.js && vite build lhk-admin-app --config lhk-admin-app/vite.config.js && vite build clg-admin-app --config clg-admin-app/vite.config.js && vite build rider-app --config rider-app/vite.config.js",
    "build:student": "vite build student-app --config student-app/vite.config.js",
    "build:admin": "vite build admin-app --config admin-app/vite.config.js",
    "build:lhk": "vite build lhk-admin-app --config lhk-admin-app/vite.config.js",
    "build:clg": "vite build clg-admin-app --config clg-admin-app/vite.config.js",
    "build:rider": "vite build rider-app --config rider-app/vite.config.js",
    "render:build": "npm run build:all",
    "render:start": "node server/server.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@supabase/supabase-js": "^2.116.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "framer-motion": "^12.4.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "nodemailer": "^10.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5"
  }
}
